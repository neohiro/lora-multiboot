# EditorConfig keeps our own sources uniform.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,hpp,c,cpp}]
indent_size = 2

[*.{py,ps1,toml,go}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown, so leave them alone.
trim_trailing_whitespace = false

[*.csv]
# Partition tables are read by the bootloader and by tools/flash.py. Trailing
# whitespace after a comma is not cosmetic here, it is a field.
trim_trailing_whitespace = true
